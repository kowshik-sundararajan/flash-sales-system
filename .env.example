# Read from the process environment by apps/api.
PORT=3000
DB_URL=mongodb://localhost:27017/ecommerce
REDIS_URL=redis://localhost:6379
SALE_ID=8f3c1d2e-5a4b-4c6d-9e7f-1a2b3c4d5e6f

# The demo sale, read by the seed (npm run seed -w apps/api, or docker compose).
# Start: SALE_STARTS_AT (ISO 8601), else now + SALE_STARTS_IN_SECONDS.
# End:   SALE_ENDS_AT (ISO 8601), else start + SALE_DURATION_SECONDS.
SALE_STARTS_AT=
SALE_ENDS_AT=
SALE_STARTS_IN_SECONDS=15
SALE_DURATION_SECONDS=3600
SALE_STOCK=100
